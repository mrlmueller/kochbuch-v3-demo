# Wird von docker-compose.yml gelesen, nicht vom Backend.
#
# Compose löst ${DB_USER} & Co. aus dieser Datei oder aus der Shell-Umgebung auf —
# NICHT aus der unter `env_file:` angegebenen backend/.env. Ohne diese Datei
# startet der Postgres-Container mit leerem Passwort und bricht ab.
#
#   cp .env.example .env
#
# Die Werte müssen mit backend/.env übereinstimmen.

DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=kochbuch
