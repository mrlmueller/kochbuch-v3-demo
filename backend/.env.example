DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=kochbuch
DB_SSLMODE=disable
# WARNING: set sslmode=require for production (managed Postgres, RDS, etc.)

SERVER_ADDR=:8080
ALLOWED_ORIGIN=https://your-vercel-app.vercel.app

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_USER_ID=

# AI image-to-recipe (optional). A provider is skipped if its API key is empty.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-5.6-luna
AI_WORKERS=2
AI_PER_USER_ACTIVE_LIMIT=3
AI_PER_USER_DAILY_LIMIT=20
AI_GLOBAL_QUEUE_LIMIT=50

# SerpAPI key (Google Images via serpapi.com). Required for /api/image-search.
SERP_API_KEY=

# Resend transactional email — initial password-setup email.
RESEND_API_KEY=
RESEND_FROM=noreply@mail.yourdomain.tld
# Base URL of the frontend; used to build the /auth/action setup link.
FRONTEND_URL=https://your-vercel-app.vercel.app

# Single-session enforcement (non-admins). Defaults to enforced when unset/blank
# (leave unset in production). Set to false in local dev to allow the same user
# in multiple browsers.
ENFORCE_SINGLE_SESSION=
